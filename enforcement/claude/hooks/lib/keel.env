# Keel enforcement runtime config — sourced by every hook via common.sh.
# Edit this to advance the rollout; no reinstall needed.
#
#   1 = TRACKING   — hooks observe and log, never block. Use while the team learns.
#   2 = SOFT GATES — hooks warn loudly on violation but allow the action. Build the habit.
#   3 = ENFORCING  — hooks block non-compliant actions (exit 2). Full discipline.
#
# Advance one phase at a time. You can also set KEEL_ENFORCEMENT_PHASE in the environment
# to override per-shell (e.g. for debugging a hook).
# The `:-` form lets an environment variable override the file value (used for
# smoke-testing a hook at a chosen phase); with no env override, this file's value wins.
KEEL_ENFORCEMENT_PHASE="${KEEL_ENFORCEMENT_PHASE:-{{ENFORCEMENT_PHASE}}}"

# Soft cap the file-length hook uses.
KEEL_MAX_FILE_LINES="${KEEL_MAX_FILE_LINES:-{{MAX_FILE_LINES}}}"

# Space-separated globs marking governance-recursive paths (edits here require an
# adversarial-review debate transcript — see verify-review-approval.sh). Tune to your repo.
KEEL_GOVERNANCE_GLOBS=".claude/CLAUDE.md .claude/hooks/* .keel/core/constitution/* .keel/core/governance/* {{ADR_DIR}}/*"

# Boundary isolation (IR-01) — used by verify-architecture-drift.sh.
# Space-separated boundary names + the single shared/importable one.
# (`:-` form so a test/CI run can override via the environment.)
KEEL_BOUNDARIES="${KEEL_BOUNDARIES:-{{BOUNDARIES_RAW}}}"
KEEL_SHARED_BOUNDARY="${KEEL_SHARED_BOUNDARY:-{{SHARED_BOUNDARY}}}"

# Frozen interfaces (IR-22) — used by verify-interface-stability.sh.
# Space-separated path globs whose surface must not change without Tier-4 sign-off.
# Empty = none declared yet (hook is a no-op). Example:
#   KEEL_FROZEN_INTERFACES="*/EventPublisher.* */contracts/*.proto"
KEEL_FROZEN_INTERFACES="${KEEL_FROZEN_INTERFACES:-}"

# API contract files (IR-04/14) — used by verify-api-contract.sh.
# Space-separated globs watched for breaking (removed/renamed) surface.
KEEL_CONTRACT_GLOBS="${KEEL_CONTRACT_GLOBS:-*openapi.yaml *openapi.yml *api-contract.yaml *api-contract.yml *.proto}"
